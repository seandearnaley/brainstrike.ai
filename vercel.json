{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    {
      "source": "/notes/feed.xml",
      "destination": "https://docs.brainstrike.ai/devlog/rss.xml",
      "permanent": true
    },
    { "source": "/notes", "destination": "https://docs.brainstrike.ai/devlog/", "permanent": true },
    { "source": "/notes/", "destination": "https://docs.brainstrike.ai/devlog/", "permanent": true },
    {
      "source": "/notes/:slug",
      "destination": "https://docs.brainstrike.ai/devlog/:slug/",
      "permanent": true
    },
    {
      "source": "/notes/:slug/",
      "destination": "https://docs.brainstrike.ai/devlog/:slug/",
      "permanent": true
    }
  ]
}
