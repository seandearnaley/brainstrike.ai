---
// Draws a Mermaid diagram at build time with pele, the renderer the app itself
// uses for diagrams in a thread. The output is inline SVG coloured by CSS
// variables (see brand.css), so it follows the theme and ships no JavaScript.
// A node with `click <id> href "..."` becomes a real link.
//
// Invalid Mermaid throws here, which fails the build.
import { createHash } from 'node:crypto';
import { render } from 'pele';

interface Props {
  /** Mermaid source, usually imported from src/diagrams/<name>.mmd?raw. */
  code: string;
  /** What the diagram shows. Not shown on the page: it names the figure for
   * screen readers and stands in for the diagram in llms-full.txt. */
  caption: string;
}

const { code, caption } = Astro.props;
// Each diagram's marker ids must be unique on the page.
const idPrefix = `d${createHash('sha1').update(code).digest('hex').slice(0, 8)}`;
const { svg } = render(code, {
  fontFamily: 'Instrument Sans',
  idPrefix,
  links: true,
  maxWidth: 620,
});
---

<figure class="diagram not-content">
  <div class="diagram-canvas" set:html={svg} />
  <figcaption class="sr-only">{caption}</figcaption>
</figure>
